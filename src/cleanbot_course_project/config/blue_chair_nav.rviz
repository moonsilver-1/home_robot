Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Value: true
      Cell Size: 1
      Color: 160; 160; 164
      Line Style:
        Line Width: 0.03
        Value: Lines
      Normal Cell Count: 0
      Reference Frame: <Fixed Frame>
      Plane: XY
      Plane Cell Count: 50

    - Class: rviz/TF
      Name: TF
      Enabled: true
      Value: true
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Marker Scale: 1
      Update Interval: 0
      Frames:
        All Enabled: true

    - Class: rviz/Map
      Name: Map
      Enabled: true
      Value: true
      Topic: /map
      Color Scheme: map
      Draw Behind: false
      Alpha: 0.7
      Use Timestamp: false

    - Class: rviz/LaserScan
      Name: Laser Scan
      Enabled: true
      Value: true
      Topic: /scan
      Size: 0.05
      Color: 255; 0; 0
      Use Fixed Frame: true
      Style: Points
      Alpha: 1.0

    - Class: rviz/Marker
      Name: Chair Marker
      Enabled: true
      Value: true
      Topic: /rgbd_blue_chair_nav/chair_marker
      Queue Size: 1

    - Class: rviz/Marker
      Name: Goal Marker
      Enabled: true
      Value: true
      Topic: /rgbd_blue_chair_nav/goal_marker
      Queue Size: 1

    - Class: rviz/Image
      Name: Annotated Image
      Enabled: true
      Value: true
      Topic: /rgbd_blue_chair_nav/annotated_image
      Transport Hint: raw
      Normalize Range: true

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 12
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.35
      Target Frame: <Fixed Frame>
      Yaw: 2.4
Window Geometry:
  Width: 1200
  Height: 900
  X: 100
  Y: 100
