Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Value: true
      Cell Size: 1
      Color: 160; 160; 164
      Line Style:
        Line Width: 0.03
        Value: Lines
      Normal Cell Count: 0
      Reference Frame: <Fixed Frame>
      Plane: XY
      Plane Cell Count: 50

    - Class: rviz/TF
      Name: TF
      Enabled: true
      Value: true
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 3
      Update Interval: 0
      Frame Timeout: 15

    - Class: rviz/Map
      Name: SLAM Map
      Enabled: true
      Value: true
      Topic: /map
      Color Scheme: map
      Draw Behind: false
      Alpha: 0.7
      Use Timestamp: false

    - Class: rviz/Map
      Name: Global Costmap
      Enabled: true
      Value: true
      Topic: /move_base/global_costmap/costmap
      Color Scheme: costmap
      Draw Behind: false
      Alpha: 0.5
      Use Timestamp: false

    - Class: rviz/Map
      Name: Local Costmap
      Enabled: true
      Value: true
      Topic: /move_base/local_costmap/costmap
      Color Scheme: costmap
      Draw Behind: false
      Alpha: 0.6
      Use Timestamp: false

    - Class: rviz/Path
      Name: Global Path
      Enabled: true
      Value: true
      Topic: /move_base/NavfnROS/plan
      Color: 25; 255; 0
      Alpha: 1.0
      Line Style:
        Line Width: 0.05
        Value: Lines

    - Class: rviz/Path
      Name: Local Path
      Enabled: true
      Value: true
      Topic: /move_base/DWAPlannerROS/local_plan
      Color: 255; 255; 0
      Alpha: 1.0
      Line Style:
        Line Width: 0.04
        Value: Lines

    - Class: rviz/Path
      Name: Cleaning Path
      Enabled: true
      Value: true
      Topic: /room_coverage_cleaner/cleaning_path
      Color: 0; 170; 255
      Alpha: 0.9
      Line Style:
        Line Width: 0.04
        Value: Lines

    - Class: rviz/LaserScan
      Name: Laser Scan
      Enabled: true
      Value: true
      Topic: /scan
      Size: 0.05
      Color: 255; 0; 0
      Use Fixed Frame: true
      Style: Points
      Alpha: 1.0

    - Class: rviz/MarkerArray
      Name: Cleaning Markers
      Enabled: true
      Value: true
      Topic: /room_coverage_cleaner/cleaning_markers

    - Class: rviz/Polygon
      Name: Robot Footprint
      Enabled: true
      Value: true
      Topic: /move_base/local_costmap/robot_footprint
      Color: 0; 255; 0
      Alpha: 0.8

    - Class: rviz/Odometry
      Name: Odometry
      Enabled: true
      Value: true
      Topic: /odom
      Length: 1.0
      Keep: 200
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Color: 255; 100; 0
      Alpha: 0.8

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 15
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.57
      Target Frame: <Fixed Frame>
      Yaw: 3.14
Window Geometry:
  Width: 1200
  Height: 900
  X: 100
  Y: 100
