Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Value: true
      Cell Size: 1
      Color: 160; 160; 164
      Line Style:
        Line Width: 0.03
        Value: Lines
      Normal Cell Count: 0
      Reference Frame: <Fixed Frame>
      Plane: XY
      Plane Cell Count: 50

    - Class: rviz/TF
      Name: TF
      Enabled: true
      Value: true
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 1
      Update Interval: 0

    - Class: rviz/PointCloud2
      Name: Full Point Cloud
      Enabled: true
      Value: true
      Topic: /pointcloud_output
      Queue Size: 5
      Style: Points
      Size (Pixels): 3
      Size (m): 0.01
      Alpha: 1.0
      Use Fixed Frame: true
      Color Transformer: RGB8
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 0
        Min Value: 0
      Use rainbow: false
      Position Transformer: XYZ

    - Class: rviz/PointCloud2
      Name: Target Point Cloud
      Enabled: true
      Value: true
      Topic: /pointcloud_target_cloud
      Queue Size: 5
      Style: Points
      Size (Pixels): 4
      Size (m): 0.01
      Alpha: 1.0
      Use Fixed Frame: true
      Color Transformer: RGB8
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 0
        Min Value: 0
      Use rainbow: false
      Position Transformer: XYZ

    - Class: rviz/Marker
      Name: Target Point
      Enabled: true
      Value: true
      Topic: /rgbd_target_distance/target_marker
      Queue Size: 1

  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: camera_rgb_optical_frame
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 4
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.05
      Target Frame: <Fixed Frame>
      Yaw: 0.78
Window Geometry:
  Width: 1200
  Height: 900
  X: 100
  Y: 100
