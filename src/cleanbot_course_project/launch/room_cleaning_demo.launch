<launch>
  <arg name="rooms_file" default="$(find cleanbot_course_project)/config/rooms.yaml" />
  <arg name="command_topic" default="/cleanbot/clean_room" />
  <arg name="move_base_action" default="/move_base" />
  <arg name="goal_timeout" default="20.0" />
  <arg name="retry_count" default="0" />
  <arg name="enable_cmd_vel_fallback" default="true" />
  <arg name="fallback_goal_timeout" default="25.0" />
  <arg name="dry_run" default="false" />
  <arg name="autostart_room" default="" />
  <arg name="autostart_delay" default="0.5" />
  <arg name="frame_id" default="map" />
  <arg name="status_topic" default="~status" />
  <arg name="path_topic" default="~cleaning_path" />
  <arg name="marker_topic" default="~cleaning_markers" />

  <node pkg="cleanbot_course_project" type="room_coverage_cleaner.py" name="room_coverage_cleaner" output="screen">
    <param name="rooms_file" value="$(arg rooms_file)" />
    <param name="command_topic" value="$(arg command_topic)" />
    <param name="move_base_action" value="$(arg move_base_action)" />
    <param name="goal_timeout" value="$(arg goal_timeout)" />
    <param name="retry_count" value="$(arg retry_count)" />
    <param name="enable_cmd_vel_fallback" value="$(arg enable_cmd_vel_fallback)" />
    <param name="fallback_goal_timeout" value="$(arg fallback_goal_timeout)" />
    <param name="dry_run" value="$(arg dry_run)" />
    <param name="autostart_room" value="$(arg autostart_room)" />
    <param name="autostart_delay" value="$(arg autostart_delay)" />
    <param name="frame_id" value="$(arg frame_id)" />
    <param name="status_topic" value="$(arg status_topic)" />
    <param name="path_topic" value="$(arg path_topic)" />
    <param name="marker_topic" value="$(arg marker_topic)" />
  </node>
</launch>
