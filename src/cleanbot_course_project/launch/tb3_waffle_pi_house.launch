<launch>
  <!-- TurtleBot3 Waffle Pi model -->
  <arg name="model" default="$(optenv TURTLEBOT3_MODEL waffle_pi)" />
  <arg name="gui" default="true" />
  <arg name="rviz" default="true" />

  <!-- Spawn pose -->
  <arg name="x_pos" default="-1.5" />
  <arg name="y_pos" default="0.0" />
  <arg name="z_pos" default="0.08" />
  <arg name="yaw" default="0.0" />

  <!-- Gazebo world -->
  <arg name="world_name"
       default="$(find aws_robomaker_small_house_world)/worlds/small_house.world" />

  <!-- Make sure Gazebo can find AWS house models -->
  <env name="GAZEBO_MODEL_PATH"
       value="$(find aws_robomaker_small_house_world)/models:$(optenv GAZEBO_MODEL_PATH)" />

  <!-- Start Gazebo with GUI -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world_name)" />
    <arg name="paused" value="false" />
    <arg name="use_sim_time" value="true" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="headless" value="false" />
    <arg name="debug" value="false" />
    <arg name="verbose" value="true" />
  </include>

  <!-- Load local CleanBot Waffle Pi xacro -->
  <param name="robot_description"
         command="$(find xacro)/xacro --inorder $(find cleanbot_course_project)/urdf/cleanbot_waffle_pi.urdf.xacro" />

  <!-- Publish robot TF -->
  <node pkg="robot_state_publisher"
        type="robot_state_publisher"
        name="robot_state_publisher"
        output="screen"
        respawn="true">
    <param name="publish_frequency" type="double" value="50.0" />
  </node>

  <!-- Spawn TurtleBot3 Waffle Pi into Gazebo -->
  <node pkg="gazebo_ros"
        type="spawn_model"
        name="spawn_cleanbot_waffle_pi"
        output="screen"
        args="-urdf
              -model cleanbot_waffle_pi
              -x $(arg x_pos)
              -y $(arg y_pos)
              -z $(arg z_pos)
              -Y $(arg yaw)
              -param robot_description" />

  <node if="$(arg rviz)"
        pkg="rviz"
        type="rviz"
        name="rviz"
        output="screen"
        args="-d $(find cleanbot_course_project)/config/robot_basic.rviz" />
</launch>
