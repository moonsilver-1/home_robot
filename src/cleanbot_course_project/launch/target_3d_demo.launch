<launch>
  <arg name="detection_topic" default="/yolo/detections_json" />
  <arg name="depth_topic" default="/camera/depth/image_raw" />
  <arg name="camera_info_topic" default="/camera/depth/camera_info" />
  <arg name="target_class" default="person" />
  <arg name="point_topic" default="~target_point" />
  <arg name="marker_topic" default="~target_marker" />
  <arg name="depth_window_size" default="5" />
  <arg name="camera_frame" default="" />
  <arg name="depth_scale" default="1.0" />

  <node pkg="cleanbot_course_project" type="target_3d_locator.py" name="target_3d_locator" output="screen">
    <param name="detection_topic" value="$(arg detection_topic)" />
    <param name="depth_topic" value="$(arg depth_topic)" />
    <param name="camera_info_topic" value="$(arg camera_info_topic)" />
    <param name="target_class" value="$(arg target_class)" />
    <param name="point_topic" value="$(arg point_topic)" />
    <param name="marker_topic" value="$(arg marker_topic)" />
    <param name="depth_window_size" value="$(arg depth_window_size)" />
    <param name="camera_frame" value="$(arg camera_frame)" />
    <param name="depth_scale" value="$(arg depth_scale)" />
  </node>
</launch>
