<launch>
  <arg name="gui" default="true" />
  <arg name="world_name" default="$(find aws_robomaker_small_house_world)/worlds/small_house.world" />
  <arg name="x_pos" default="-1.5" />
  <arg name="y_pos" default="0.0" />
  <arg name="z_pos" default="0.08" />
  <arg name="yaw" default="0.0" />

  <arg name="rgb_topic" default="/camera/rgb/image_raw" />
  <arg name="depth_topic" default="/camera/depth/image_raw" />
  <arg name="camera_info_topic" default="/camera/depth/camera_info" />
  <arg name="frame_id" default="camera_rgb_optical_frame" />
  <arg name="step" default="2" />
  <arg name="publish_rate" default="10.0" />
  <arg name="save_pcd" default="true" />
  <arg name="pcd_output_path" default="/tmp/output_cloud.pcd" />
  <arg name="rviz" default="true" />

  <include file="$(find cleanbot_course_project)/launch/tb3_waffle_pi_house.launch">
    <arg name="gui" value="$(arg gui)" />
    <arg name="world_name" value="$(arg world_name)" />
    <arg name="x_pos" value="$(arg x_pos)" />
    <arg name="y_pos" value="$(arg y_pos)" />
    <arg name="z_pos" value="$(arg z_pos)" />
    <arg name="yaw" value="$(arg yaw)" />
    <arg name="rviz" value="false" />
  </include>

  <node pkg="cleanbot_course_project"
        type="get_pointcloud.py"
        name="get_pointcloud"
        output="screen">
    <param name="rgb_topic" value="$(arg rgb_topic)" />
    <param name="depth_topic" value="$(arg depth_topic)" />
    <param name="camera_info_topic" value="$(arg camera_info_topic)" />
    <param name="frame_id" value="$(arg frame_id)" />
    <param name="step" value="$(arg step)" />
    <param name="publish_rate" value="$(arg publish_rate)" />
    <param name="save_pcd" value="$(arg save_pcd)" />
    <param name="pcd_output_path" value="$(arg pcd_output_path)" />
  </node>

  <node if="$(arg rviz)"
        pkg="rviz"
        type="rviz"
        name="rviz"
        output="screen"
        args="-d $(find cleanbot_course_project)/config/pointcloud.rviz" />
</launch>
