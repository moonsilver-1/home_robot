<launch>
  <arg name="gui" default="true" />
  <arg name="rviz" default="true" />
  <arg name="world_name" default="$(find aws_robomaker_small_house_world)/worlds/small_house.world" />
  <arg name="x_pos" default="-1.5" />
  <arg name="y_pos" default="0.0" />
  <arg name="z_pos" default="0.08" />
  <arg name="yaw" default="0.0" />

  <arg name="rgb_topic" default="/camera/rgb/image_raw" />
  <arg name="depth_topic" default="/camera/depth/image_raw" />
  <arg name="camera_info_topic" default="/camera/depth/camera_info" />
  <arg name="camera_frame" default="camera_rgb_optical_frame" />
  <arg name="map_frame" default="map" />
  <arg name="base_frame" default="base_footprint" />
  <arg name="publish_rate" default="10.0" />
  <arg name="min_area" default="500" />
  <arg name="approach_distance" default="0.9" />
  <arg name="goal_tolerance" default="0.25" />
  <arg name="resend_distance" default="0.35" />
  <arg name="show_debug" default="false" />
  <arg name="chair_hsv_lower" default="100,80,20" />
  <arg name="chair_hsv_upper" default="130,255,170" />
  <arg name="visual_steering_sign" default="-1.0" />

  <include file="$(find cleanbot_course_project)/launch/static_room_cleaning_demo.launch">
    <arg name="gui" value="$(arg gui)" />
    <arg name="rviz" value="false" />
    <arg name="world_name" value="$(arg world_name)" />
    <arg name="x_pos" value="$(arg x_pos)" />
    <arg name="y_pos" value="$(arg y_pos)" />
    <arg name="z_pos" value="$(arg z_pos)" />
    <arg name="yaw" value="$(arg yaw)" />
  </include>

  <node pkg="cleanbot_course_project"
        type="rgbd_blue_chair_nav.py"
        name="rgbd_blue_chair_nav"
        output="screen">
    <param name="rgb_topic" value="$(arg rgb_topic)" />
    <param name="depth_topic" value="$(arg depth_topic)" />
    <param name="camera_info_topic" value="$(arg camera_info_topic)" />
    <param name="camera_frame" value="$(arg camera_frame)" />
    <param name="map_frame" value="$(arg map_frame)" />
    <param name="base_frame" value="$(arg base_frame)" />
    <param name="publish_rate" value="$(arg publish_rate)" />
    <param name="min_area" value="$(arg min_area)" />
    <param name="approach_distance" value="$(arg approach_distance)" />
    <param name="goal_tolerance" value="$(arg goal_tolerance)" />
    <param name="resend_distance" value="$(arg resend_distance)" />
    <param name="show_debug" value="$(arg show_debug)" />
    <param name="chair_hsv_lower" value="$(arg chair_hsv_lower)" />
    <param name="chair_hsv_upper" value="$(arg chair_hsv_upper)" />
    <param name="visual_steering_sign" value="$(arg visual_steering_sign)" />
  </node>

  <node if="$(arg rviz)"
        pkg="rviz"
        type="rviz"
        name="rviz"
        output="screen"
        args="-d $(find cleanbot_course_project)/config/blue_chair_nav.rviz" />
</launch>
