<?xml version="1.0"?>
<robot name="robot_vacuum" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="pi" value="3.1415926535897931" />

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0" />
      <mass value="6.0" />
      <inertia ixx="0.043" iyy="0.043" izz="0.078" ixy="0" iyz="0" ixz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.19" length="0.05" />
      </geometry>
      <material name="vacuum_body">
        <color rgba="0.12 0.12 0.12 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.19" length="0.05" />
      </geometry>
    </collision>
  </link>

  <link name="left_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.12" />
      <inertia ixx="0.00004" iyy="0.00004" izz="0.00004" ixy="0" iyz="0" ixz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.035" length="0.025" />
      </geometry>
      <material name="wheel_dark">
        <color rgba="0.05 0.05 0.05 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.035" length="0.025" />
      </geometry>
    </collision>
  </link>

  <link name="right_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.12" />
      <inertia ixx="0.00004" iyy="0.00004" izz="0.00004" ixy="0" iyz="0" ixz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.035" length="0.025" />
      </geometry>
      <material name="wheel_dark">
        <color rgba="0.05 0.05 0.05 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.035" length="0.025" />
      </geometry>
    </collision>
  </link>

  <link name="caster_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="0.00001" iyy="0.00001" izz="0.00001" ixy="0" iyz="0" ixz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.02" />
      </geometry>
      <material name="caster_gray">
        <color rgba="0.45 0.45 0.45 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.02" />
      </geometry>
    </collision>
  </link>

  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" iyz="0" ixz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.012" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.024" />
      </geometry>
      <material name="lidar_black">
        <color rgba="0.18 0.18 0.18 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.012" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.024" />
      </geometry>
    </collision>
  </link>

  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="0.00002" iyy="0.00002" izz="0.00002" ixy="0" iyz="0" ixz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.05 0.04 0.03" />
      </geometry>
      <material name="camera_white">
        <color rgba="0.82 0.82 0.82 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.05 0.04 0.03" />
      </geometry>
    </collision>
  </link>

  <link name="rgbd_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.12" />
      <inertia ixx="0.00003" iyy="0.00003" izz="0.00003" ixy="0" iyz="0" ixz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.06 0.045 0.035" />
      </geometry>
      <material name="camera_blue">
        <color rgba="0.25 0.32 0.42 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.06 0.045 0.035" />
      </geometry>
    </collision>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="left_wheel_link" />
    <origin xyz="0 0.12 0.035" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="right_wheel_link" />
    <origin xyz="0 -0.12 0.035" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link" />
    <child link="caster_link" />
    <origin xyz="-0.13 0 -0.005" rpy="0 0 0" />
  </joint>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link" />
    <child link="lidar_link" />
    <origin xyz="0.0 0.0 0.05" rpy="0 0 0" />
  </joint>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link" />
    <child link="camera_link" />
    <origin xyz="0.13 0.0 0.055" rpy="0 0 0" />
  </joint>

  <joint name="rgbd_joint" type="fixed">
    <parent link="base_link" />
    <child link="rgbd_link" />
    <origin xyz="0.12 0.0 0.045" rpy="0 0 0" />
  </joint>

  <gazebo reference="base_link">
    <material>Gazebo/Black</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <selfCollide>true</selfCollide>
    <gravity>true</gravity>
  </gazebo>

  <gazebo reference="left_wheel_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>1000</mu1>
    <mu2>1000</mu2>
    <selfCollide>true</selfCollide>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>1000</mu1>
    <mu2>1000</mu2>
    <selfCollide>true</selfCollide>
  </gazebo>

  <gazebo reference="lidar_link">
    <material>Gazebo/Black</material>
    <selfCollide>true</selfCollide>
  </gazebo>

  <gazebo reference="camera_link">
    <material>Gazebo/White</material>
    <selfCollide>true</selfCollide>
  </gazebo>

  <gazebo reference="rgbd_link">
    <material>Gazebo/Blue</material>
    <selfCollide>true</selfCollide>
  </gazebo>

  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <updateRate>100.0</updateRate>
      <leftJoint>left_wheel_joint</leftJoint>
      <rightJoint>right_wheel_joint</rightJoint>
      <wheelSeparation>0.24</wheelSeparation>
      <wheelDiameter>0.07</wheelDiameter>
      <wheelAcceleration>1.0</wheelAcceleration>
      <wheelTorque>30.0</wheelTorque>
      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_link</robotBaseFrame>
      <publishWheelTF>true</publishWheelTF>
      <publishOdom>true</publishOdom>
      <publishWheelJointState>true</publishWheelJointState>
      <legacyMode>false</legacyMode>
    </plugin>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor type="ray" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>40</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-1.57079632679</min_angle>
            <max_angle>1.57079632679</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>20.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_laser.so">
        <topicName>/scan</topicName>
        <frameName>lidar_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="rgbd_link">
    <sensor type="depth" name="rgbd_sensor">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>30.0</update_rate>
      <camera>
        <horizontal_fov>1.0471975512</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>
      </camera>
      <plugin name="rgbd_plugin" filename="libgazebo_ros_openni_kinect.so">
        <alwaysOn>true</alwaysOn>
        <updateRate>30.0</updateRate>
        <cameraName>camera</cameraName>
        <imageTopicName>/camera/rgb/image_raw</imageTopicName>
        <cameraInfoTopicName>/camera/rgb/camera_info</cameraInfoTopicName>
        <depthImageTopicName>/camera/depth/image_raw</depthImageTopicName>
        <depthImageCameraInfoTopicName>/camera/depth/camera_info</depthImageCameraInfoTopicName>
        <pointCloudTopicName>/camera/depth/points</pointCloudTopicName>
        <frameName>rgbd_link</frameName>
        <hackBaseline>0.07</hackBaseline>
      </plugin>
    </sensor>
  </gazebo>
</robot>
